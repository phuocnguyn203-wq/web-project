# Caddy gets and renews the HTTPS certificate for $DOMAIN by itself (DNS must already point here).
{$DOMAIN} {
	encode zstd gzip

	# Worker-to-API callbacks stay on the Docker network (more specific than /api/*, so it wins).
	handle /api/internal/* {
		respond 404
	}

	# API: the frontend is built with NEXT_PUBLIC_API_URL=/api, so the browser never leaves this origin.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
