# Copy to .env. docker compose reads it for api + worker.

# Auth — use a long random string in production: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-64-char-random-string
CORS_ORIGINS=http://localhost:3000

# YouTube links use the video's own captions (vi first, else en) when it has them; no GPU needed.
# Speech-to-text for uploads / caption-less videos: mock | phowhisper | whisper  (needs `pip install .[speech]` + GPU)
SPEECH_ENGINE=mock

# LLM: mock | openai  (openai = any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Tried in order when a model hits its daily quota (Groq: 200k tokens/day per model on the free tier).
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b   (Groq qwen models cap output at 1k tokens/min on the free tier: too small for card generation)
# Examples:
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=openai/gpt-oss-120b
#   Ollama (self-host): LLM_BASE_URL=http://host.docker.internal:11434/v1         LLM_MODEL=qwen2.5:7b

# Per-request output cap; providers count input + this against tokens/minute (Groq free tier: 8k TPM).
# LLM_MAX_TOKENS=3000
# gpt-oss models only: low | medium | high hidden reasoning (low keeps requests inside free-tier limits).
# LLM_REASONING_EFFORT=low

MAX_UPLOAD_MB=1024
# Local dev without Redis: run jobs inline in the request
# SYNC_JOBS=1
