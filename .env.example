# Copy to .env. docker compose reads it for api + worker.

# Auth — use a long random string in production: openssl rand -hex 32
# (the API refuses to start in production with this placeholder)
JWT_SECRET=change-me-to-a-64-char-random-string
CORS_ORIGINS=http://localhost:3000
# 0 = only students can sign up. Open it, create your teacher account, then close it on a public server.
ALLOW_TEACHER_SIGNUP=1

# --- Production only (deploy/docker-compose.prod.yml; see deploy/README.md) ---
# DOMAIN=lecturecards.example.com
# POSTGRES_PASSWORD=   # openssl rand -hex 24  (hex: it goes inside the database URL)

# YouTube links use the video's own captions (vi first, else en) when it has them.
# Speech-to-text for uploads / caption-less videos:
#   mock       fixed sample transcript (no key needed)
#   api        hosted Whisper over an OpenAI-compatible /audio/transcriptions (Groq whisper-large-v3); no GPU
#   phowhisper | whisper   local models, needs `pip install .[speech]` + GPU
SPEECH_ENGINE=mock
# api engine reuses LLM_BASE_URL / LLM_API_KEY unless these are set:
# SPEECH_BASE_URL=https://api.groq.com/openai/v1
# SPEECH_API_KEY=
# SPEECH_MODEL=whisper-large-v3

# LLM: mock | openai  (openai = any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Tried in order when a model hits its daily quota (Groq: 200k tokens/day per model on the free tier).
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b   (Groq qwen models cap output at 1k tokens/min on the free tier: too small for card generation)
# Examples:
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=openai/gpt-oss-120b
#   Ollama (self-host): LLM_BASE_URL=http://host.docker.internal:11434/v1         LLM_MODEL=qwen2.5:7b

# Per-request output cap; providers count input + this against tokens/minute (Groq free tier: 8k TPM).
# LLM_MAX_TOKENS=3000
# gpt-oss models only: low | medium | high hidden reasoning (low keeps requests inside free-tier limits).
# LLM_REASONING_EFFORT=low

MAX_UPLOAD_MB=1024
# Local dev without Redis: run jobs inline in the request
# SYNC_JOBS=1
